# Copy to .env.local and fill in. Never commit .env.local.
# Create a Speech resource at https://portal.azure.com (the free F0 tier is enough).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Optional: change the voices. Portuguese must be a pt-PT voice.
# PT_VOICE=pt-PT-RaquelNeural      # or pt-PT-DuarteNeural
# EN_VOICE=en-GB-SoniaNeural       # or en-US-JennyNeural for American English
