# Settings for `npm run audio` (Azure text-to-speech). The website itself never reads these.
#
# On your computer: copy this file to .env.local (or .env) and fill it in. Never commit those files.
# On Netlify: add the same names under Site configuration → Environment variables instead
#   (mark AZURE_SPEECH_KEY as a secret). Never prefix them with NEXT_PUBLIC_.
#
# Create a Speech resource at https://portal.azure.com (the free F0 tier is enough).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Optional: change the voices. Portuguese must be a pt-PT voice.
# PT_VOICE=pt-PT-RaquelNeural      # or pt-PT-DuarteNeural
# EN_VOICE=en-GB-SoniaNeural       # or en-US-JennyNeural for American English
